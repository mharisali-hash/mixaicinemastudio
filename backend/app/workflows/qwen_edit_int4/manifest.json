{
  "name": "qwen_edit_int4",
  "family": "qwen-image-edit-2509",
  "description": "Qwen-Image-Edit-2509 as Nunchaku SVDQuant INT4 with Lightning 4-step fused in (nunchaku-tech, Apache-2.0, ~13 GB). Speed trial, 24 Nov: the 2511 community INT4 needs an unmerged Nunchaku patch and a third-party LoRA loader, so the trial uses the official 2509 build.",
  "inputs": {
    "prompt": {
      "type": "str",
      "required": true,
      "targets": [
        [
          "Positive",
          "prompt"
        ]
      ]
    },
    "negative": {
      "type": "str",
      "default": "",
      "targets": [
        [
          "Negative",
          "prompt"
        ]
      ]
    },
    "images": {
      "type": "image_list",
      "required": true,
      "min": 1,
      "slots": [
        [
          "Ref1",
          "image"
        ],
        [
          "Ref2",
          "image"
        ],
        [
          "Ref3",
          "image"
        ]
      ],
      "drop_unused": [
        [
          "Ref2",
          "Ref2Scale"
        ],
        [
          "Ref3",
          "Ref3Scale"
        ]
      ]
    },
    "width": {
      "type": "int",
      "default": 768,
      "multiple_of": 16,
      "targets": [
        [
          "Latent",
          "width"
        ]
      ]
    },
    "height": {
      "type": "int",
      "default": 1024,
      "multiple_of": 16,
      "targets": [
        [
          "Latent",
          "height"
        ]
      ]
    },
    "seed": {
      "type": "int",
      "default": 0,
      "targets": [
        [
          "Sampler",
          "seed"
        ]
      ]
    },
    "steps": {
      "type": "int",
      "default": 4,
      "targets": [
        [
          "Sampler",
          "steps"
        ]
      ]
    },
    "scheduler": {
      "type": "str",
      "default": "simple",
      "targets": [
        [
          "Sampler",
          "scheduler"
        ]
      ]
    },
    "filename_prefix": {
      "type": "str",
      "default": "mixai/qwenedit_int4",
      "targets": [
        [
          "Save",
          "filename_prefix"
        ]
      ]
    }
  },
  "outputs": {
    "image": {
      "node": "Save",
      "kind": "image"
    }
  },
  "models": {
    "diffusion_models": [
      "svdq-int4_r128-qwen-image-edit-2509-lightningv2.0-4steps.safetensors"
    ],
    "text_encoders": [
      "qwen_2.5_vl_7b_fp8_scaled.safetensors"
    ],
    "vae": [
      "qwen_image_vae.safetensors"
    ]
  },
  "progress_weights": {
    "Sampler": 6,
    "UNet": 3,
    "TextEncoder": 2,
    "Positive": 1,
    "Negative": 1
  }
}
